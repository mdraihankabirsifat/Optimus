# Non-secret configuration for the Escave server and client. Nothing here is a
# credential; the game uses none.

# Server: port to listen on. Render sets this automatically; locally the default is 8910.
PORT=8910

# Client: the server a game connects to by default is chosen in this order:
#   1. --server-url=wss://... on the game's command line
#   2. ?server=wss://... in the web build's page address
#   3. the last server typed into the online lobby (saved in user settings)
#   4. AppConfig.PUBLIC_SERVER_URL (set it after deploying, the live one is wss://six-ways-down-server.onrender.com)
#   5. ws://127.0.0.1:8910
